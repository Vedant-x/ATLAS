# Environment for running the build locally (node scripts/pages.mjs). Copy to .env and fill in what you
# use; nothing here is required. Never commit .env. In GitHub Actions the same names come from the
# repository's secrets and variables (Settings > Secrets and variables > Actions).

# The Odds API (https://the-odds-api.com): bookmaker prices and the sharp (Pinnacle) line.
# Free plan: 500 credits a month. Secret in GitHub; leave empty to run without it.
ODDS_API_KEY=
# Optional tuning (GitHub repository variables). Defaults in brackets.
ODDS_REGIONS=          # [eu]  bookmaker regions; eu includes Pinnacle
ODDS_MARKETS=          # [h2h] markets per request; each extra market costs a credit per region
ODDS_HOURS=            # [12]  refresh a league's odds once they are this many hours old
ODDS_MAX_SPORTS=       # [no cap] most paid requests per build; 0 = none (CI sets 0)

# OddsPapi (https://oddspapi.io): Stake's own prices, and Pinnacle's. Free account: about 250 requests
# a month. Secret in GitHub; leave empty to run without it.
ODDSPAPI_KEY=
ODDSPAPI_MONTHLY=      # [240] requests a month to spend, at an even pace
ODDSPAPI_BUDGET=       # 0 = only reuse the live site's prices (CI sets 0)

# TheSportsDB reads per build [24]; 0 = only reuse the live site's cache (CI sets 0).
TSDB_BUDGET=
# Where the previous build's data is read from [https://vedant-x.github.io/ATLAS/data/index.json].
SITE_DATA_URL=

# Track record (scripts/record.mjs): most result lookups per run [150]; 1 = refuse to start a new
# history when the saved one is missing (the deploy workflow sets it).
RECORD_MAX_LOOKUPS=
TRACK_REQUIRED=

# Local preview server port (npm start) [8080].
PORT=

# Email alerts (GitHub secrets only; leave unset to rely on the GitHub issue):
# MAIL_USERNAME, MAIL_PASSWORD (a Gmail app password) and ALERT_EMAIL.
